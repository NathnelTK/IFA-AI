# =============================================================================
# IFA — repository ignore rules
# NOTE: source files (*.ts, *.js, *.svelte, *.cs) are intentionally TRACKED.
#       Only dependencies, build output, caches and local configuration are
#       excluded so the repository stays clean and reviewable.
# =============================================================================

# -----------------------------------------------------------------------------
# .NET / C#
# -----------------------------------------------------------------------------
bin/
obj/
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.DotSettings.user
*.nupkg
*.snupkg
TestResults/
*.trx
*.coverage
coverage*.xml
project.lock.json
project.fragment.lock.json

# -----------------------------------------------------------------------------
# Node / SvelteKit / Vite
# -----------------------------------------------------------------------------
node_modules/
.svelte-kit/
.vite/
build/
dist/
.vercel/
.netlify/
.eslintcache
.stylelintcache
*.tsbuildinfo
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.editorconfig
# -----------------------------------------------------------------------------
# Environment & local secrets
# Local DB connection settings and passwords live in `.env` (see .env.example).
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.local.json
appsettings.Local.json
appsettings.*.local.json
*.pfx
*.p12

# -----------------------------------------------------------------------------
# Logs & temporary files
# -----------------------------------------------------------------------------
*.log
logs/
tmp/
temp/
*.tmp

# -----------------------------------------------------------------------------
# OS artifacts
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# -----------------------------------------------------------------------------
# Kilo / Agent Manager runtime state (worktrees, sessions, local plans)
# -----------------------------------------------------------------------------
.kilo/worktrees/
.kilo/agent-manager.json
.kilo/kilo.jsonc
.kilo/state/
.kilo/tmp/
IFA_STARK_Updated_Specification/
