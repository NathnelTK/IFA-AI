{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Database": {
    "Host": "localhost",
    "Port": 5432,
    "Name": "ifa",
    "User": "ifa"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:4173"]
  },
  "Payments": {
    "AllowedReturnOrigins": ["http://localhost:5173", "http://127.0.0.1:5173"]
  },
  "Auth": {
    "Issuer": "Witforge.Auth",
    "LegacyAudience": "Witforge.LegacyClient",
    "SessionHours": 12,
    "InternalRequestMaxSkewSeconds": 90,
    "CentralHosts": ["auth.witforge.com"],
    "AppHosts": ["app.witforge.com"],
    "PublicHosts": ["witforge.com", "www.witforge.com"],
    "Clients": [
      {
        "ClientId": "witforge-app",
        "TargetHost": "app.witforge.com",
        "TargetSite": "App",
        "RedirectUris": ["https://app.witforge.com/auth/callback"]
      }
    ]
  },
  "LlmGateway": {
    "UseOllama": true
  },
  "Ai": {
    "DefaultProvider": "Gemini",
    "AllowCrossProviderFailover": false,
    "Gemini": {
      "Model": "gemini-3.5-flash"
    },
    "Groq": {
      "Model": "openai/gpt-oss-120b"
    },
    "Pipelines": {
      "Model1": {
        "Provider": "Gemini"
      },
      "Model2": {
        "Provider": "Gemini"
      },
      "Model3": {
        "Provider": "Gemini"
      },
      "Tutor": {
        "Provider": "Gemini"
      }
    }
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "llama3.2:3b"
  },
  "AllowedHosts": "*"
}
