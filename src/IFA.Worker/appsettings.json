{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Workers": {
    "Generation": {
      "Enabled": true,
      "MaxInFlight": 3,
      "PollSeconds": 5,
      "LeaseSeconds": 120,
      "HeartbeatSeconds": 30,
      "MaxAttempts": 3
    },
    "Authoring": {
      "Enabled": true,
      "MaxInFlight": 2,
      "PollSeconds": 5,
      "LeaseSeconds": 180,
      "HeartbeatSeconds": 30
    },
    "Assets": {
      "Enabled": true,
      "MaxInFlight": 2,
      "PollSeconds": 5,
      "LeaseSeconds": 300,
      "HeartbeatSeconds": 30
    },
    "Domains": {
      "Enabled": true,
      "PollSeconds": 30,
      "LeaseSeconds": 120,
      "MaxInFlight": 5
    },
    "Certificates": {
      "Enabled": true,
      "PollSeconds": 10,
      "LeaseSeconds": 120,
      "MaxInFlight": 2
    },
    "Payments": {
      "Enabled": true,
      "PollSeconds": 30,
      "LeaseSeconds": 60,
      "MaxInFlight": 10
    },
    "Outbox": {
      "Enabled": true,
      "BatchSize": 20,
      "PollSeconds": 5,
      "LeaseSeconds": 60
    },
    "Maintenance": {
      "Enabled": true,
      "IntervalMinutes": 60,
      "ProcessedOutboxRetentionDays": 30
    }
  },
  "Features": {
    "CourseGeneration": true,
    "DurableOutbox": true
  },
  "Ai": {
    "DefaultProvider": "Gemini",
    "AllowCrossProviderFailover": false,
    "Gemini": {
      "Model": "gemini-3.5-flash"
    },
    "Groq": {
      "Model": "openai/gpt-oss-120b"
    },
    "Pipelines": {
      "Model1": { "Provider": "Gemini" },
      "Model2": { "Provider": "Gemini" },
      "Model3": { "Provider": "Gemini" },
      "Tutor": { "Provider": "Gemini" }
    }
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "llama3.2:3b"
  }
}
