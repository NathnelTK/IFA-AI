# =============================================================================
# Witforge environment configuration (template)
# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# must never be committed. Docker Compose and the API both read it.
# =============================================================================

# Database Provider - Use 'postgres' for production, 'sqlite' for local development only
DB_PROVIDER=postgres

# PostgreSQL connection settings (Production Ready)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ifa
DB_USER=ifa
DB_PASSWORD=change_me_to_secure_password

# Alternative: use DATABASE_URL for the normal runtime connection string.
# DATABASE_URL=postgresql://user:password@host:port/database
# Optional DDL-capable connection used only by `IFA.Worker migrate`.
# MIGRATION_DATABASE_URL=postgresql://migration_user:password@host:port/database
# API and worker runtime processes never change schema.
DB_INITIALIZATION_MODE=none

# JWT Secret - Generate a unique random value with at least 32 characters.
# PowerShell: $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=replace_with_a_unique_random_secret_of_at_least_32_characters
BFF_INTERNAL_SECRET=replace_with_a_separate_random_secret_of_at_least_32_characters
AUTH_CONTEXT_PEPPER=replace_with_a_random_context_hash_pepper
# Generate exactly 32 random bytes and base64-encode them. API and worker must share it.
AUTH_DATA_PROTECTION_KEY=replace_with_base64_encoded_32_byte_key
# One-time bootstrap only. Remove both after the first PlatformAdmin grant.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_TOTP_SECRET=
AUTH_PUBLIC_URL=http://localhost:5173
PUBLIC_AUTH_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=https://witforge.com
EMAIL_DELIVERY_MODE=Development
# Production: set EMAIL_DELIVERY_MODE=Resend and configure both values.
RESEND_API_KEY=
EMAIL_FROM=

# LLM Providers - Add your API keys for AI functionality
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# Default AI Provider (Gemini, Groq, or Ollama)
AI_DEFAULT_PROVIDER=Groq
# Keep source content on the selected hosted provider unless cross-vendor
# failover has been reviewed and intentionally enabled.
AI_ALLOW_CROSS_PROVIDER_FAILOVER=false

# Dedicated worker leases and bounded retries
Workers__Generation__Enabled=true
Workers__Generation__MaxInFlight=3
Workers__Generation__PollSeconds=5
Workers__Generation__LeaseSeconds=120
Workers__Generation__HeartbeatSeconds=30
Workers__Generation__MaxAttempts=3
Workers__Authoring__Enabled=true
Workers__Authoring__MaxInFlight=2
Workers__Authoring__PollSeconds=5
Workers__Authoring__LeaseSeconds=180
Workers__Authoring__HeartbeatSeconds=30
Workers__Assets__Enabled=true
Workers__Assets__MaxInFlight=2
Workers__Assets__PollSeconds=5
Workers__Assets__LeaseSeconds=300
Workers__Assets__HeartbeatSeconds=30
Workers__Domains__Enabled=true
Workers__Domains__PollSeconds=30
Workers__Domains__LeaseSeconds=120
Workers__Domains__MaxInFlight=5
Workers__Certificates__Enabled=true
Workers__Certificates__PollSeconds=10
Workers__Certificates__LeaseSeconds=120
Workers__Certificates__MaxInFlight=2
Workers__Payments__Enabled=true
Workers__Payments__PollSeconds=30
Workers__Payments__LeaseSeconds=60
Workers__Payments__MaxInFlight=10
Workers__Outbox__Enabled=true
Workers__Outbox__BatchSize=20
Workers__Outbox__PollSeconds=5
Workers__Outbox__LeaseSeconds=60
Workers__Maintenance__Enabled=true
Workers__Maintenance__IntervalMinutes=60
Workers__Maintenance__ProcessedOutboxRetentionDays=30

# Independent rollout switches. Keep additive schema deployed before enabling.
Features__Workspaces=false
Features__OpaqueSessions=false
Features__UnifiedAuthoring=false
Features__AssetUploads=false
Features__ImmutableReleases=false
Features__PublicPresence=false
Features__CustomDomains=false
Features__Social=false
Features__Certificates=false
Features__Offers=false
Features__RedesignedShells=false

# Cloudflare R2 private object storage
R2_SERVICE_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=witforge-assets
R2_PUBLIC_BASE_URL=
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
OCR_SERVICE_URL=
OCR_API_KEY=

# Vercel custom-domain automation
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
CUSTOM_DOMAIN_CNAME_TARGET=domains.witforge.com

# External Services
# Academic research: OpenAlex + Wikimedia Commons need no key. Semantic
# Scholar works keyless with low rate limits; a key raises them. Tavily needs
# a key for web/news/image search.
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
YOUTUBE_API_KEY=your_youtube_api_key_here

# Payments — Chapa (Ethiopian aggregator, sandbox by default).
# Sandbox: https://api.chapa.co/v1 (test secret key "CHAPUBK-...").
# Production: https://api.chapaco.co/v1 with a live secret key.
CHAPA_SECRET_KEY=your_chapa_secret_key_here
CHAPA_BASE_URL=https://api.chapa.co/v1
# Optional HTTPS API endpoint for Chapa's server callback, for example:
# CHAPA_CALLBACK_URL=https://api.example.com/api/payments/webhook
# Secret used to validate Chapa webhook signatures (set in Chapa dashboard).
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret_here
# Payment callbacks are intentionally independent from browser CORS origins.
# External educator websites must never appear in this allowlist.
PAYMENT_RETURN_ORIGINS=http://localhost:5173

# CORS Configuration - Add your frontend URLs
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourapp.com

# Development is seeded automatically. Production demo accounts/catalog data
# are opt-in and demo login is disabled unless this is true.
DEMO_DATA_ENABLED=false

# Application Settings
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
