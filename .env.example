# =============================================================================
# IFA environment configuration (template)
# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# must never be committed. Docker Compose and the API both read it.
# =============================================================================

# Database Provider - Use 'postgres' for production, 'sqlite' for local development only
DB_PROVIDER=postgres

# PostgreSQL connection settings (Production Ready)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ifa
DB_USER=ifa
DB_PASSWORD=change_me_to_secure_password

# Alternative: Use DATABASE_URL for connection string
# DATABASE_URL=postgresql://user:password@host:port/database

# JWT Secret - Generate a secure random key for production (minimum 32 characters)
JWT_SECRET=IFA_SUPER_SECRET_SECURITY_KEY_FOR_HACKATHON_DEMO_2026_LONG_ENOUGH

# LLM Providers - Add your API keys for AI functionality
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# Default AI Provider (Gemini, Groq, or Ollama)
AI_DEFAULT_PROVIDER=Gemini

# External Services
YOUTUBE_API_KEY=your_youtube_api_key_here

# CORS Configuration - Add your frontend URLs
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourapp.com

# Application Settings
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
