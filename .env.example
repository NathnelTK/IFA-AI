# =============================================================================
# IFA environment configuration (template)
# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# must never be committed. Docker Compose and the API both read it.
# =============================================================================

# PostgreSQL connection settings.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ifa
DB_USER=ifa
DB_PASSWORD=ifa_dev_password

# -----------------------------------------------------------------------------
# AI model gateway (3-model pipeline).
# A provider is enabled only when its API key is set; the gateway falls back
# from the first provider in AI_PROVIDER_FALLBACK_ORDER to the next on rate
# limits / transport errors. Model and base URL are optional (sensible free-tier
# defaults are used when omitted).
# -----------------------------------------------------------------------------
# Google Gemini (primary — Learning Advisor / Course Architect / Course Builder).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_ENABLED=true
# GEMINI_TIMEOUT_SECONDS=60

# Groq (fallback — OpenAI-compatible chat completions, e.g. Llama 3.3).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_ENABLED=true
# GROQ_TIMEOUT_SECONDS=60

# Comma-separated provider priority order.
# AI_PROVIDER_FALLBACK_ORDER=Gemini,Groq
