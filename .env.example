# =============================================================================
# IFA environment configuration (template)
# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# must never be committed. Docker Compose and the API both read it.
# =============================================================================

# Database Provider - Use 'postgres' for production, 'sqlite' for local development only
DB_PROVIDER=postgres

# PostgreSQL connection settings (Production Ready)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ifa
DB_USER=ifa
DB_PASSWORD=change_me_to_secure_password

# Alternative: Use DATABASE_URL for connection string
# DATABASE_URL=postgresql://user:password@host:port/database

# JWT Secret - Generate a unique random value with at least 32 characters.
# PowerShell: $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=replace_with_a_unique_random_secret_of_at_least_32_characters

# LLM Providers - Add your API keys for AI functionality
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# Default AI Provider (Gemini, Groq, or Ollama)
AI_DEFAULT_PROVIDER=Groq

# External Services
# Academic research: OpenAlex + Wikimedia Commons need no key. Semantic
# Scholar works keyless with low rate limits; a key raises them. Tavily needs
# a key for web/news/image search.
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
YOUTUBE_API_KEY=your_youtube_api_key_here

# Payments — Chapa (Ethiopian aggregator, sandbox by default).
# Sandbox: https://api.chapa.co/v1 (test secret key "CHAPUBK-...").
# Production: https://api.chapaco.co/v1 with a live secret key.
CHAPA_SECRET_KEY=your_chapa_secret_key_here
CHAPA_BASE_URL=https://api.chapa.co/v1
# Secret used to validate Chapa webhook signatures (set in Chapa dashboard).
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret_here

# CORS Configuration - Add your frontend URLs
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourapp.com

# Application Settings
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
