# syntax=docker/dockerfile:1

# ---------------------------------------------------------------------------
# Build stage — install dependencies and compile the SvelteKit app.
# ---------------------------------------------------------------------------
FROM node:22-alpine AS build
WORKDIR /app

COPY client/package.json client/package-lock.json ./
RUN npm ci

COPY client/ ./
RUN npm run build

# ---------------------------------------------------------------------------
# Runtime stage — production dependencies plus the adapter-node output.
# ---------------------------------------------------------------------------
FROM node:22-alpine AS runtime
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOST=0.0.0.0

COPY client/package.json client/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY --from=build /app/build ./build

EXPOSE 3000
CMD ["node", "build"]
