# syntax=docker/dockerfile:1

FROM mcr.microsoft.com/dotnet/sdk:10.0-alpine AS build
WORKDIR /src

COPY Directory.Build.props ./
COPY src/IFA.Domain/IFA.Domain.csproj src/IFA.Domain/packages.lock.json src/IFA.Domain/
COPY src/IFA.Application/IFA.Application.csproj src/IFA.Application/packages.lock.json src/IFA.Application/
COPY src/IFA.Infrastructure/IFA.Infrastructure.csproj src/IFA.Infrastructure/packages.lock.json src/IFA.Infrastructure/
COPY src/IFA.Worker/IFA.Worker.csproj src/IFA.Worker/packages.lock.json src/IFA.Worker/
RUN dotnet restore src/IFA.Worker/IFA.Worker.csproj --locked-mode

COPY src/ src/
RUN dotnet publish src/IFA.Worker/IFA.Worker.csproj \
    -c Release \
    -o /app/publish \
    /p:UseAppHost=false \
    /p:PublishTrimmed=false

FROM mcr.microsoft.com/dotnet/runtime:10.0-alpine AS runtime
RUN apk add --no-cache ca-certificates tzdata icu-libs libgcc libstdc++ font-dejavu \
    && update-ca-certificates \
    && addgroup -g 1001 -S appgroup \
    && adduser -S appuser -G appgroup -u 1001

WORKDIR /app
ENV DOTNET_ENVIRONMENT=Production
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false
COPY --from=build /app/publish .
RUN chown -R appuser:appgroup /app
USER appuser
ENTRYPOINT ["dotnet", "IFA.Worker.dll"]
