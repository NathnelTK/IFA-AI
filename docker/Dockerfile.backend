# syntax=docker/dockerfile:1

# ---------------------------------------------------------------------------
# Build stage — restore first (cached), then publish the API in Release.
# ---------------------------------------------------------------------------
FROM mcr.microsoft.com/dotnet/sdk:10.0-alpine AS build
WORKDIR /src

# Copy project files for dependency resolution
COPY src/IFA.Domain/IFA.Domain.csproj src/IFA.Domain/
COPY src/IFA.Application/IFA.Application.csproj src/IFA.Application/
COPY src/IFA.Infrastructure/IFA.Infrastructure.csproj src/IFA.Infrastructure/
COPY src/IFA.API/IFA.API.csproj src/IFA.API/

# Restore NuGet packages
RUN dotnet restore src/IFA.API/IFA.API.csproj

# Copy all source code
COPY src/ src/

# Publish the application in Release mode
RUN dotnet publish src/IFA.API/IFA.API.csproj \
    -c Release \
    -o /app/publish \
    /p:UseAppHost=false \
    /p:PublishTrimmed=false

# ---------------------------------------------------------------------------
# Runtime stage — minimal ASP.NET Core image for production.
# ---------------------------------------------------------------------------
FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine AS runtime

# Install the native dependencies the ASP.NET Core runtime needs. The alpine
# image ships no ICU, and with DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false the
# runtime calls FailFast at startup when libicu is missing (exits 139).
RUN apk add --no-cache \
    ca-certificates \
    tzdata \
    icu-libs \
    libgcc \
    libstdc++ \
    && update-ca-certificates

# Create non-root user for security
RUN addgroup -g 1001 -S appgroup && \
    adduser -S appuser -G appgroup -u 1001

WORKDIR /app

# Set environment variables for production
ENV ASPNETCORE_ENVIRONMENT=Production
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false

# Expose port. Render's default PORT is 10000, so the entrypoint below binds to
# $PORT when the platform supplies one and falls back to 8080 everywhere else
# (local docker-compose sets ASPNETCORE_URLS explicitly, which still wins).
EXPOSE 8080

# Copy published application
COPY --from=build /app/publish .

# Change ownership to non-root user
RUN chown -R appuser:appgroup /app

# Switch to non-root user
USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider "http://localhost:${PORT:-8080}/api/health" || exit 1

# Start the application. An explicit ASPNETCORE_URLS wins; otherwise bind to the
# platform's $PORT (Render uses 10000) or 8080 for local Docker.
ENTRYPOINT ["/bin/sh", "-c", "export ASPNETCORE_URLS=${ASPNETCORE_URLS:-http://+:${PORT:-8080}}; exec dotnet IFA.API.dll"]
