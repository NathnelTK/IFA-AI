# -----------------------------------------------------------------------------
# IFA frontend environment (template)
#
# Copy this file to `client/.env` for local development. Everything prefixed
# with VITE_ is inlined into the browser bundle and is PUBLIC — never put a
# provider key, JWT secret, or database password here.
#
# Server-side secrets (GEMINI_API_KEY, JWT_SECRET, DB_PASSWORD, ...) belong in
# the repository-root `.env`, which only the backend and Docker Compose read.
# -----------------------------------------------------------------------------

# Base URL of the IFA.API backend.
# Local launch profile: http://localhost:5011
# Docker (api published on host): http://localhost:5011
VITE_API_URL=http://localhost:5011

# Voxide voice assistant — PUBLISHABLE key only (starts with `vox_pub_`).
# Get it from the Voxide dashboard → project → Integration tab, and whitelist
# your origin (localhost always works) under project → Settings.
# NOTE: the secret `vox_sk_...` key is NOT used in the browser; do not put it here.
# Leave blank to keep the voice assistant disabled.
VITE_VOXIDE_KEY=
