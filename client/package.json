{
  "name": "ifa-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:e2e": "playwright test --project=smoke --project=a11y --project=responsive",
    "test:e2e:smoke": "playwright test --project=smoke",
    "test:e2e:a11y": "playwright test --project=a11y",
    "test:e2e:visual": "playwright test --project=visual",
    "test:e2e:visual:update": "playwright test --project=visual --update-snapshots",
    "serve:e2e": "node scripts/serve-e2e.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.61.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/adapter-vercel": "^5.10.3",
    "@sveltejs/kit": "^2.16.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/typography": "^0.5.20",
    "autoprefixer": "^10.4.20",
    "lucide-svelte": "^0.474.0",
    "postcss": "^8.5.1",
    "svelte": "^5.19.2",
    "svelte-check": "^4.1.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "dompurify": "^3.4.17",
    "gsap": "^3.15.1",
    "marked": "^14.1.4"
  }
}
